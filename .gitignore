# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── WhatsApp Auth Session (contains sensitive session data) ───────────────────
.wwebjs_auth/
.wwebjs_cache/

# ── Environment Variables ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Runtime / State Data ──────────────────────────────────────────────────────
# db.json stores live queue state — not needed in version control.
# The app will recreate it on first run.
db.json

# ── Windows Batch Launchers (local dev convenience scripts) ───────────────────
*.bat

# ── Backup Archives ───────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar

# ── OS & Editor Artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor Folders ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──────────────────────────────────────────────────────────────────────
.npmrc